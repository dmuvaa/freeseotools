# Production URL of the application
# This is required for server-side fetches to resolve relative paths
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google PageSpeed Insights API key (for the Lighthouse audit tool)
# Get one at: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
PAGESPEED_API_KEY=your_api_key_here

# OpenRouter API key (for the AI SEO Chat Assistant)
# Get one free at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here
