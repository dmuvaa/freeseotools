                                    className="flex-1 px-4 py-3 rounded-xl bg-error text-white font-medium hover:bg-error-hover transition-colors"
                                >
                                    Delete
                                </button>
                            </div>
                        </motion.div>
                    </div>
                )}
            </AnimatePresence>
        </div>
    )
}
